{
    "folders": [
        {
            "name": "Root",
            "path": "."
        }
    ],
    "settings": {
        "java.configuration.updateBuildConfiguration": "automatic",
        "java.compile.nullAnalysis.mode": "disabled",
        "java.jdt.ls.vmargs": "-Xmx4G -XX:+UseG1GC",
        "files.watcherExclude": {
            "**/.git/objects/**": true,
            "**/target/**": true, 
            "**/build/**": true,
            "**/.gradle/**": true,
            "**/.minecraft/**": true
        },
        "editor.bracketPairColorization.enabled": false,
        "editor.tokenColorCustomizations": {
            "textMateRules": [
                {
                    "scope": [
                        "source.json punctuation.definition",
                        "source.json constant.language",
                        "storage.type.primitive.java",
                        "source.java entity.name.type.enum",
                        "source.java constant.numeric",
                        "source.java constant.language",
                        "source.java keyword.control",
                        "source.java storage.modifier",
                        "source.java storage.type.function.arrow",
                        "source.java punctuation.definition.annotation-arguments",
                        "storage.type.annotation.java",
                        "source.java punctuation.definition.annotation",
                        "source.java storage.modifier.package",
                        "source.java keyword.operator.assignment"
                    ],
                    "settings": {
                        "fontStyle": "bold"
                    }
                },
                {
                    "scope": [
                        "source.java keyword.other",
                        "source.java keyword.control",
                        "source.java storage.modifier",
                        "source.java storage.type.function.arrow"
                    ],
                    "settings": {
                        "foreground": "#e06c75"
                    }
                },
                {
                    "scope": [
                        "keyword.control.throw.java",
                        "source.java meta.throwables storage.modifier",
                        "source.java constant.language.null.java"
                    ],
                    "settings": {
                        "foreground": "#CC5030",
                        "fontStyle": "bold"
                    }
                },
                {
                    "scope": [
                        "source.java keyword.control.new"
                    ],
                    "settings": {
                        "foreground": "#C586C0"
                    }
                },
                {
                    "scope": [
                        "source.java entity.name.type.class",
                        "source.java entity.name.type.interface"
                    ],
                    "settings": {
                        "foreground": "#9eb8d7"
                    }
                },
                {
                    "scope": "source.java entity.name.function",
                    "settings": {
                        "foreground": "#61AFEF"
                    }
                },
                {
                    "scope": [
                        "source.java punctuation.separator",
                        "source.java punctuation.bracket",
                        "source.java variable.parameter"
                    ],
                    "settings": {
                        "foreground": "#bcbcbc"
                    }
                },
                {
                    "scope": [
                        "source.java punctuation.definition.annotation-arguments",
                        "storage.type.annotation.java",
                        "source.java punctuation.definition.annotation"
                    ],
                    "settings": {
                        "foreground": "#eacc6a"
                    }
                },
                {
                    "scope": [
                        "source.java constant.numeric",
                        "storage.type.primitive.java",
                        "source.java entity.name.type.enum",
                        "source.java constant.language"
                    ],
                    "settings": {
                        "foreground": "#D19A66"
                    }
                },
                {
                    "scope": [
                        "source.java keyword.operator.increment-decrement",
                        "source.java keyword.operator.arithmetic"
                    ],
                    "settings": {
                        "foreground": "#C586C0"
                    }
                },
                {
                    "scope": [
                        "support.type.property-name.json",
                        "source.java string.quoted.double",
                        "source.java string.quoted.single"
                    ],
                    "settings": {
                        "foreground": "#79c388"
                    }
                },
                {
                    "scope": [
                        "source.java comment.line"
                    ],
                    "settings": {
                        "fontStyle": "italic"
                    }
                },
                {
                    "scope": [
                        "source.java meta.method-call entity.name.function",
                        "source.java meta.function-call entity.name.function"
                    ],
                    "settings": {
                        "foreground": "#e0cc9a"
                    }
                },
                {
                    "scope": [
                        "source.java meta.method.identifier entity.name.function"
                    ],
                    "settings": {
                        "foreground": "#eacc6a"
                    }
                },
                {
                    "scope": [
                        "source.java punctuation.terminator",
                        "source.java comment.line",
                        "source.java comment.line punctuation.definition.comment"
                    ],
                    "settings": {
                        "foreground": "#525967"
                    }
                },
                {
                    "scope": [
                        "source.json punctuation.separator",
                        "source.java punctuation.section",
                        "source.java punctuation.bracket",
                        "source.java punctuation.separator.delimiter",
                        "source.java punctuation.definition.parameters",
                        "source.java comment.block",
                        "source.java comment.block punctuation.definition.comment"
                    ],
                    "settings": {
                        "foreground": "#727a8a"
                    }
                },
                {
                    "scope": [
                        "source.java variable.other",
                        "source.java storage.modifier.import"
                    ],
                    "settings": {
                        "foreground": "#bcbcbc"
                    }
                },
                {
                    "scope": [
                        "source.java support.class",
                        "source.java storage.type"
                    ],
                    "settings": {
                        "foreground": "#9eb8d7"
                    }
                },
                {
                    "scope": [
                        "source.java keyword"
                    ],
                    "settings": {
                        "foreground": "#bcbcbc"
                    }
                }
            ]
        },
        "editor.semanticTokenColorCustomizations": {
            "rules": {
                "class:java": "#9eb8d7",
                "class.constructor:java": {
                    "bold": true
                },
                "class.declaration:java": {
                    "foreground": "#ebace5",
                    "bold": false,
                },
                "interface:java": "#9eb8d7",
                "enum:java": "#9eb8d7",
                "enumMember:java": {
                    "foreground": "#6e8bc4",
                    "bold": true,
                },
                "namespace:java": {
                    "foreground": "#bcbcbc",
                    "bold": true
                },
                "namespace.importDeclaration:java": {
                    "bold": false
                },
                "method:java": "#e0cc9a",
                "method.declaration:java": "#eacc6a",
                "parameter:java": {
                    "foreground": "#c6b6b2",
                    "italic": true
                },
                "parameter.readonly:java": {
                    "foreground": "#a6a1c7",
                    "italic": false
                },
                "property:java": {
                    "foreground": "#bcdcec",
                    "italic": true
                },
                "property.readonly:java": {
                    "foreground": "#6e8bc4",
                    "italic": false
                },
                "variable:java": {
                    "foreground": "#bcdcec",
                    "italic": true
                },
                "variable.readonly:java": {
                    "foreground": "#8e9fc2",
                    "italic": false
                },
                "keyword:java": "#e06c75",
                "modifier:java": "#e06c75"
            }
        },
        "java.import.gradle.java.home": "C:\\Program Files\\Eclipse Adoptium\\jdk-21.0.11.10-hotspot"
    }
}